# Copy to .env (never commit .env). Names only: fill values locally / in the Render dashboard.

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Storage (defaults are fine locally)
DATABASE_PATH=
UPLOAD_DIR=
MAX_UPLOAD_MB=15
FRONTEND_DIST=

# AI gateway
AI_TIMEOUT_SECONDS=30
# true = serve cached responses from AI_SAMPLES_DIR before calling any provider (demo safety net)
AI_USE_CACHED_SAMPLES=false
# Optional: point at a gitignored folder (e.g. data_private/ai_samples) for real-data caches
AI_SAMPLES_DIR=

# Primary provider: Sarvam AI (UNKNOWN: exact base URL/model; confirm from Sarvam docs)
SARVAM_API_KEY=
SARVAM_BASE_URL=
SARVAM_MODEL=

# Fallback provider (UNKNOWN which; see docs/mentor_questions.md)
FALLBACK_AI_PROVIDER=
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=
FALLBACK_AI_MODEL=

# Frontend (build-time, Vite): serve mock JSON instead of calling the API
VITE_USE_MOCKS=false
